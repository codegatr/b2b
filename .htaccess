Options -Indexes

# PHP dosyaları uploads'ta çalışmasın
<FilesMatch "\.(php|php3|php4|php5|phtml)$">
    <If "%{REQUEST_URI} =~ m#^/uploads/#">
        Deny from all
    </If>
</FilesMatch>

# Install klasörü kurulum sonrası kapatılır (rename veya şu satırı aç)
# <Location /install>
#     Deny from all
# </Location>

# Yedek / log dosyaları
<FilesMatch "\.(bak|sql|log|zip|tar|gz)$">
    Deny from all
</FilesMatch>

# Gizli dosyalar
<FilesMatch "^\.">
    Deny from all
</FilesMatch>

# UTF-8
AddDefaultCharset UTF-8

# Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache
# Not: CSS/JS dosyaları PHP'de ?v=<hash> ile çağrılıyor (dosya değişince
# hash değişir, tarayıcı yeni dosyayı çeker). Bu yüzden uzun cache
# süresi güvenli — query string farklı olduğunda yeni dosya zaten alınır.
<IfModule mod_expires.c>
    ExpiresActive On
    # CSS/JS — query string ile cache busted; 1 yıl agresif cache
    ExpiresByType text/css            "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    # Resimler statik, uzun cache
    ExpiresByType image/png           "access plus 30 days"
    ExpiresByType image/jpeg          "access plus 30 days"
    ExpiresByType image/gif           "access plus 30 days"
    ExpiresByType image/webp          "access plus 30 days"
    ExpiresByType image/svg+xml       "access plus 30 days"
    # Font'lar değişmez
    ExpiresByType font/woff2          "access plus 1 year"
    ExpiresByType font/woff           "access plus 1 year"
    # HTML cache'lenmesin — her istek dinamik
    ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

# HTML için Cache-Control: no-cache (proxy/CDN'lerin tutmaması için)
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# XSS / Clickjacking koruması
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
